{
  "name": "@erisera-code/circuit",
  "version": "0.3.0",
  "description": "The erisera OSS design system \u2014 one set of tokens, one accent hue per tool.",
  "license": "MIT",
  "type": "module",
  "author": "John Henry",
  "homepage": "https://opensource.johnhenry.me/circuit/",
  "repository": {
    "type": "git",
    "url": "github:erisera-code/circuit",
    "directory": "packages/circuit"
  },
  "keywords": [
    "design-system",
    "css-tokens",
    "docs-theme",
    "erisera",
    "design-tokens"
  ],
  "files": [
    "src"
  ],
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./themes.css": "./src/themes.css",
    "./components.css": "./src/components.css",
    "./palette.css": "./src/palette.css",
    "./palette.js": "./src/palette.js",
    "./theme-toggle.js": "./src/theme-toggle.js",
    "./index.css": "./src/index.css",
    "./marks/*": "./src/marks/*",
    "./tokens": {
      "types": "./src/tokens.d.ts",
      "import": "./src/tokens.js",
      "default": "./src/tokens.js"
    },
    "./namespaced.css": "./src/namespaced.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-namespaced.mjs",
    "test": "node --test \"test/*.test.mjs\""
  }
}
