{
  "name": "@erisera-code/circuit-react",
  "version": "0.1.1",
  "description": "React components (Radix-based), design tokens, and site CSS for the erisera OSS design system.",
  "license": "MIT",
  "type": "module",
  "author": "John Henry",
  "homepage": "https://opensource.johnhenry.me/circuit/",
  "repository": {
    "type": "git",
    "url": "github:erisera-code/circuit",
    "directory": "packages/circuit-react"
  },
  "keywords": [
    "design-system",
    "react",
    "radix-ui",
    "css-tokens",
    "erisera"
  ],
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./react": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": "./src/css/index.css",
    "./css/tokens.css": "./src/css/tokens.css",
    "./css/base.css": "./src/css/base.css",
    "./css/layout.css": "./src/css/layout.css",
    "./css/components.css": "./src/css/components.css",
    "./css/sections.css": "./src/css/sections.css",
    "./css/utilities.css": "./src/css/utilities.css",
    "./css/animations.css": "./src/css/animations.css",
    "./tokens": "./src/tokens/index.css",
    "./tokens/semantic.css": "./src/tokens/semantic.css"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
