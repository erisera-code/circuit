{
  "name": "@erisera-code/circuit-engine",
  "version": "0.5.0",
  "description": "The erisera design engine: a headless, class-free CSS system that styles bare semantic HTML by element and tree position, with swappable design instances (circuit, jjhub, noitroidvania, snake and more), light-dark tokens, @scope-isolated facets and cascade layers \u2014 plus the skin mount that lets an existing app try any instance over its own markup.",
  "license": "MIT",
  "author": "John Henry <john@iamjohnhenry.com>",
  "type": "module",
  "homepage": "https://opensource.johnhenry.me/circuit/",
  "repository": {
    "type": "git",
    "url": "github:erisera-code/circuit",
    "directory": "packages/engine"
  },
  "publishConfig": {
    "access": "public"
  },
  "style": "./dist/engine.min.css",
  "exports": {
    ".": "./dist/engine.min.css",
    "./mount": "./src/mount.js",
    "./engine.css": "./dist/engine.css",
    "./engine.min.css": "./dist/engine.min.css",
    "./core.css": "./dist/core.css",
    "./core.min.css": "./dist/core.min.css",
    "./experimental.css": "./dist/experimental.css",
    "./experimental.min.css": "./dist/experimental.min.css",
    "./instances/*": "./dist/instances/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "clean": "rm -rf dist",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "serve": "node scripts/serve.mjs",
    "stories": "node scripts/gen-stories.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "sync:family": "node scripts/sync-family.mjs"
  },
  "devDependencies": {
    "@csstools/selector-specificity": "^5.0.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "storybook": "^10.6.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "css",
    "design-system",
    "design-tokens",
    "classless",
    "headless",
    "cascade-layers",
    "custom-properties",
    "semantic-html",
    "no-build",
    "css-scope",
    "light-dark",
    "css-functions",
    "zen-garden"
  ]
}
